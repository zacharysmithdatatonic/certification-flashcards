---
interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'Certification Flashcards',
    description = 'Study for Google Cloud and Anthropic certifications with focused flashcards tailored to each exam.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <link
            rel="icon"
            type="image/png"
            href={`${import.meta.env.BASE_URL}logo.png`}
        />
        <link
            rel="apple-touch-icon"
            href={`${import.meta.env.BASE_URL}logo.png`}
        />
        <title>{title}</title>
    </head>
    <body>
        <slot />
        <script>
            import { installHierarchyHistory } from '../lib/hierarchyHistory';
            installHierarchyHistory();
        </script>
    </body>
</html>

<style is:global>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        font-family:
            'Google Sans', 'Product Sans', 'Inter', 'Roboto', 'Segoe UI',
            sans-serif;
        color: #202124;
        background: #ffffff;
    }

    body {
        margin: 0;
        min-height: 100vh;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #ffffff;
    }

    ::-webkit-scrollbar-thumb {
        background: #5f6368;
        border-radius: 4px;
    }
</style>
